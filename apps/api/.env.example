# API configuration — copy this file to .env and fill in your values
PORT=8000

# CORS: comma-separated list of allowed origins (use `*` to allow all)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/securepass-dev"

# Better Auth secret: min 32 characters, high entropy.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Better Auth base URL — the PUBLIC origin the browser uses (web app, not the API port).
# This is used for URL generation and default trustedOrigins (CSRF origin check).
BETTER_AUTH_URL=http://localhost:5173

# Credential encryption key: base64 of 32 random bytes.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""
