{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"start": "node build",
		"build": "rm -rf build && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && eslint .",
		"lint": "eslint .",
		"format": "prettier --write --ignore-unknown --list-different ."
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint",
			"prettier --write"
		],
		"*.{json,css,md}": "prettier --experimental-cli --write"
	},
	"devDependencies": {
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@iconify/svelte": "5.2.2",
		"@internationalized/date": "3.12.2",
		"@lucide/svelte": "1.25.0",
		"@packages/eslint-config": "workspace:*",
		"@packages/prettier-config": "workspace:*",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"bits-ui": "2.18.1",
		"clsx": "2.1.1",
		"eslint-plugin-svelte": "3.22.0",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "1.4.2",
		"svelte": "5.56.7",
		"svelte-check": "4.7.3",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.2.2",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"vite": "8.1.5"
	},
	"dependencies": {
		"@iconify-svelte/mdi": "1.0.2",
		"@packages/db": "workspace:*"
	}
}
