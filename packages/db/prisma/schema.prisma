generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Credential {
    id        Int      @id @default(autoincrement())
    label     String
    encryptedUsername  String // AES-256-GCM encrypted blob (JSON: {iv, tag, data})
    encryptedPassword  String // AES-256-GCM encrypted blob (JSON: {iv, tag, data})
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
